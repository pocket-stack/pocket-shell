{
  "name": "pocket-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A tiling window shell for the Nintendo 3DS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pocket-stack/pocket-shell.git"
  },
  "scripts": {
    "setup": "git submodule update --init && bun install --cwd vendor/pocketjs && bun scripts/setup.ts",
    "3ds": "bun scripts/3ds.ts",
    "guest": "bun scripts/guest.ts",
    "pair": "bun scripts/pair.ts",
    "push": "bun scripts/push.ts",
    "probe": "bun scripts/probe.ts",
    "shot": "bun scripts/shot.ts",
    "film": "bun scripts/film.ts",
    "goldens": "bun scripts/film.ts --check",
    "typecheck": "bun vendor/pocketjs/node_modules/typescript/bin/tsc --noEmit",
    "test": "bun scripts/test.ts",
    "check": "bun run typecheck && bun run test"
  }
}
