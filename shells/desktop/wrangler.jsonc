{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pocket-desktop",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist/site",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "desktop.pocketlab.build",
      "custom_domain": true
    }
  ]
}
